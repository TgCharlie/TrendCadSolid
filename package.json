{
  "name": "trendcad-solid",
  "version": "0.2.0",
  "description": "Offline 2D CAD workspace for solid surface drawing preparation",
  "main": "electron-main.cjs",
  "author": "Trendgosa Pty Ltd",
  "license": "UNLICENSED",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "node server.cjs",
    "desktop": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg"
  },
  "dependencies": { "dwgdxf": "2.0.1" },
  "devDependencies": {
    "electron": "^39.1.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.trendgosa.trendcadsolid",
    "productName": "TrendCad Solid",
    "asar": true,
    "directories": { "output": "release" },
    "files": [
      "**/*",
      "!tests{,/**}",
      "!test-results.txt",
      "!*.log",
      "!.git{,/**}"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "TgCharlie",
        "repo": "TrendCadSolid",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [ { "target": "nsis", "arch": [ "x64" ] } ],
      "artifactName": "TrendCad-Solid-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TrendCad Solid"
    },
    "mac": {
      "target": [ { "target": "dmg", "arch": [ "x64", "arm64" ] } ],
      "category": "public.app-category.graphics-design",
      "artifactName": "TrendCad-Solid-${version}-${arch}.${ext}"
    },
    "dmg": { "title": "TrendCad Solid ${version}" }
  }
}
